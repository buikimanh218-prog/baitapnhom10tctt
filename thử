        // ================= v48 PERFECT DYNAMIC CANVAS LINE ENGINE =================
        function drawMindmapLines(wrapperId) {
            const wrapper = document.getElementById(wrapperId);
            if (!wrapper) return;
            const canvas = wrapper.querySelector('.mindmap-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            const rect = wrapper.getBoundingClientRect();
            if (canvas.width !== rect.width || canvas.height !== rect.height) {
                canvas.width = rect.width;
                canvas.height = rect.height;
            }
            
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            if (!wrapper.classList.contains('active')) return;
            
            const centerNode = wrapper.querySelector('.center-node');
            if (!centerNode) return;
            const centerRect = centerNode.getBoundingClientRect();
            const centerX = (centerRect.left + centerRect.width / 2) - rect.left;
            const centerY = (centerRect.top + centerRect.height / 2) - rect.top;
            
            const branches = wrapper.querySelectorAll('.node-branch');
            branches.forEach(branch => {
                const style = window.getComputedStyle(branch);
                if (style.opacity === "0" || style.display === "none") return;
                
                const branchRect = branch.getBoundingClientRect();
                const branchX = (branchRect.left + branchRect.width / 2) - rect.left;
                const branchY = (branchRect.top + branchRect.height / 2) - rect.top;
                
                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.lineTo(branchX, branchY);
                
                const grad = ctx.createLinearGradient(centerX, centerY, branchX, branchY);
                if (wrapperId === 'mindmap-1') { grad.addColorStop(0, '#ff8fa3'); grad.addColorStop(1, '#ffcbd5'); }
                else if (wrapperId === 'mindmap-2') { grad.addColorStop(0, '#a29bfe'); grad.addColorStop(1, '#e8dbfc'); }
                else if (wrapperId === 'mindmap-3') { grad.addColorStop(0, '#ef4444'); grad.addColorStop(1, '#fca5a5'); }
                else if (wrapperId === 'mindmap-4') { grad.addColorStop(0, '#3b82f6'); grad.addColorStop(1, '#93c5fd'); }
                else if (wrapperId === 'mindmap-5') { grad.addColorStop(0, '#10b981'); grad.addColorStop(1, '#a7f3d0'); }
                else { grad.addColorStop(0, '#f59e0b'); grad.addColorStop(1, '#fde68a'); }
                
                ctx.strokeStyle = grad;
                ctx.lineWidth = 5; // Slightly bolder line
                ctx.lineCap = 'round';
                ctx.shadowBlur = 18; // Gorgeous cosmic glow
                if (wrapperId === 'mindmap-1') ctx.shadowColor = 'rgba(255, 143, 163, 0.7)';
                else if (wrapperId === 'mindmap-2') ctx.shadowColor = 'rgba(162, 155, 254, 0.7)';
                else if (wrapperId === 'mindmap-3') ctx.shadowColor = 'rgba(239, 68, 68, 0.7)';
                else if (wrapperId === 'mindmap-4') ctx.shadowColor = 'rgba(59, 130, 246, 0.7)';
                else if (wrapperId === 'mindmap-5') ctx.shadowColor = 'rgba(16, 185, 129, 0.7)';
                else ctx.shadowColor = 'rgba(245, 158, 11, 0.7)';
                
                // HIGHLY CREATIVE: Flowing Dashed Lines animation!
                ctx.setLineDash([10, 8]);
                ctx.lineDashOffset = -lineOffset;
                
                ctx.stroke();
            });
        }

