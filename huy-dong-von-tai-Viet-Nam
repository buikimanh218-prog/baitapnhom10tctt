        // Method 4 opportunity cost
        function calculateTradeCredit() {
            const dPct = parseFloat(document.getElementById('m4-discount-pct').value) || 0;
            const dDays = parseFloat(document.getElementById('m4-discount-days').value) || 0;
            const nDays = parseFloat(document.getElementById('m4-net-days').value) || 0;
            
            document.getElementById('m4-terms-display').innerText = `${dPct}% / ${dDays}, Net ${nDays}`;
            
            if(nDays <= dDays || dPct >= 100) {
                document.getElementById('m4-apr-display').innerText = "Vô hiệu (Hạn trả <= Ngày CK)";
                return;
            }
            
            const apr = (dPct / (100 - dPct)) * (365 / (nDays - dDays)) * 100;
            document.getElementById('m4-apr-display').innerText = apr.toFixed(2) + '% / năm';
            
            const recEl = document.getElementById('m4-recommendation');
            if(apr > 12) {
                recEl.innerText = "CHI PHÍ CƠ HỘI QUÁ ĐẮT - NÊN VAY NGÂN HÀNG ĐỂ TRẢ SỚM LẤY CHIẾT KHẤU";
                recEl.className = "text-rose-600 font-black";
            } else {
                recEl.innerText = "CHI PHÍ CƠ HỘI RẺ - NÊN CHỜ ĐẾN CUỐI HẠN THANH TOÁN ĐỂ CHI TIÊU";
                recEl.className = "text-emerald-600 font-black";
            }
        }


        // Method 5 Share dilution
        function simulateDilution() {
            const price = parseFloat(document.getElementById('m5-stock-price').value) || 0;
            const divPct = parseFloat(document.getElementById('m5-dividend-pct').value) || 0;
            const issuePct = parseFloat(document.getElementById('m5-new-issue-pct').value) || 0;
            const issuePrice = parseFloat(document.getElementById('m5-issue-price').value) || 0;
            const cashDiv = parseFloat(document.getElementById('m5-cash-div').value) || 0;
            
            const beta = divPct / 100; // share dividend ratio
            const alpha = issuePct / 100; // new shares ratio
            
            const dilution = (alpha / (1 + alpha + beta)) * 100;
            document.getElementById('m5-dilution-ratio').innerText = dilution.toFixed(1) + "%";
            
            // Market ex-price prediction
            const exPrice = (price + alpha * issuePrice - cashDiv) / (1 + alpha + beta);
            document.getElementById('m5-ex-price').innerText = exPrice.toLocaleString('vi-VN') + " VND";
        }


        // Method 6 Bond valuation
        function appraiseBond() {
            const faceVal = parseFloat(document.getElementById('m6-face-val').value) || 0;
            const couponRate = parseFloat(document.getElementById('m6-coupon-rate').value) || 0;
            const discountRate = parseFloat(document.getElementById('m6-discount-rate').value) || 0;
            const years = parseFloat(document.getElementById('m6-maturity-years').value) || 1;
            const freq = parseFloat(document.getElementById('m6-coupon-freq').value) || 1;
            
            const couponVal = faceVal * (couponRate / 100) / freq;
            document.getElementById('m6-coupon-val').innerText = couponVal.toLocaleString('vi-VN') + " VND";
            
            // PV calculation of cashflows
            let pv = 0;
            const totalPeriods = years * freq;
            const periodRate = (discountRate / 100) / freq;
            
            for(let i=1; i<=totalPeriods; i++) {
                pv += couponVal / Math.pow(1 + periodRate, i);
            }
            pv += faceVal / Math.pow(1 + periodRate, totalPeriods);
            
            document.getElementById('m6-fair-price').innerText = pv.toLocaleString('vi-VN') + " VND";
            
            const statEl = document.getElementById('m6-appraisal-status');
            if(pv > faceVal) {
                statEl.innerText = "TRÁI PHIẾU BÁN GIÁ CAO (PREMIUM BOND)";
                statEl.className = "text-emerald-600 font-extrabold font-black";
            } else if (pv < faceVal) {
                statEl.innerText = "TRÁI PHIẾU BÁN CHIẾT KHẤU (DISCOUNT BOND)";
                statEl.className = "text-rose-600 font-extrabold font-black";
            } else {
                statEl.innerText = "TRÁI PHIẾU BÁN NGANG MỆNH GIÁ (PAR BOND)";
                statEl.className = "text-slate-900 font-extrabold font-black";
            }
        }


