        function playNextMeasure() {
            if (!isMusicPlaying) return;
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                
                const now = audioCtx.currentTime;
                const m = cozySequence[cozyMeasureIdx];
                const beat = 0.52; // Warm waltz tempo (approx 115 BPM)
                
                // Helper to play an acoustically modeled piano/bell note
                const playPianoNote = (freq, startTime, duration, volume, isBass=false) => {
                    if (!freq || freq === 0) return;
                    
                    const oscFundamental = audioCtx.createOscillator();
                    const oscOvertone = audioCtx.createOscillator();
                    const gainNode = audioCtx.createGain();
                    const filter = audioCtx.createBiquadFilter();
                    if (!musicMasterGain) {
                        musicMasterGain = audioCtx.createGain();
                        musicMasterGain.gain.value = 0.45;
                        musicMasterGain.connect(audioCtx.destination);
                    }
                    
                    // Physical modeling: triangle base is warmer and more wooden than sine
                    oscFundamental.type = isBass ? 'triangle' : 'triangle';
                    oscFundamental.frequency.setValueAtTime(freq, startTime);
                    
                    // Add bright metallic overtone for attack brilliance
                    oscOvertone.type = 'sine';
                    oscOvertone.frequency.setValueAtTime(freq * 2, startTime);
                    
                    // Acoustic low-pass dampening sweep: attack is bright, decay is mellow
                    filter.type = 'lowpass';
                    filter.Q.setValueAtTime(1.5, startTime);
                    filter.frequency.setValueAtTime(isBass ? 800 : 1600, startTime);
                    filter.frequency.exponentialRampToValueAtTime(isBass ? 80 : 150, startTime + duration);
                    
                    // Volume Envelope: soft attack, natural exponential decay
                    gainNode.gain.setValueAtTime(0, startTime);
                    gainNode.gain.linearRampToValueAtTime(volume, startTime + 0.015);
                    gainNode.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
                    
                    // Connect nodes
                    oscFundamental.connect(filter);
                    oscOvertone.connect(filter);
                    filter.connect(gainNode);
                    gainNode.connect(musicMasterGain);
                    
                    // Start & Stop
                    oscFundamental.start(startTime);
                    oscOvertone.start(startTime);
                    oscFundamental.stop(startTime + duration + 0.1);
                    oscOvertone.stop(startTime + duration + 0.1);
                    
                    // Sympathetic string resonance (Reverb/Echo echo simulation)
                    const delayNode = audioCtx.createDelay ? audioCtx.createDelay() : null;
                    if (delayNode) {
                        const delayGain = audioCtx.createGain();
                        delayNode.delayTime.setValueAtTime(0.18, startTime); // 180ms delay
                        delayGain.gain.setValueAtTime(volume * 0.28, startTime);
                        delayGain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);
                        
                        filter.connect(delayNode);
                        delayNode.connect(delayGain);
                        delayGain.connect(musicMasterGain);
                    }
                };


                // 1. Play warm wood bass note on Beat 1 (duration: 3 beats)
                playPianoNote(m.bass, now, beat * 2.8, 0.13, true);
                
                // 2. Play cozy arpeggiated rolled chords on Beat 2 and Beat 3
                // Arpeggiate (roll) the chords slightly (idx * 0.04s) for that signature Rebecca Sugar harp feel!
                m.chord.forEach((note, idx) => {
                    playPianoNote(note, now + beat + idx * 0.04, beat * 1.8, 0.05);
                });
                m.chord.forEach((note, idx) => {
                    playPianoNote(note, now + beat * 2 + idx * 0.04, beat * 1.5, 0.04);
                });
                
                // 3. Play Rebecca Sugar's gorgeous vocal melody (bell-like brilliance) on Beats 1, 2, 3
                m.melody.forEach((noteFreq, beatIdx) => {
                    if (noteFreq && noteFreq > 0) {
                        // Melody notes are brighter and sing beautifully
                        playPianoNote(noteFreq, now + beatIdx * beat, beat * 1.2, 0.09);
                    }
                });
                
                // Advance loop
                cozyMeasureIdx = (cozyMeasureIdx + 1) % cozySequence.length;
                
            } catch (e) {
                console.warn("High-Fidelity Cozy Synth playback failed: ", e);
            }
        }
    
