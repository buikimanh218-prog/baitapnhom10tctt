        // FINAL FIX: tab switching never removes the current content/image before the new
        // image is fully loaded and decoded. Every URL is cached as a real Image object.
        const morphRenderTokens = Object.create(null);
        const morphImageCache = new Map();


        function preloadMorphImage(url) {
            if (!url) return Promise.reject(new Error('Missing image URL'));
            if (morphImageCache.has(url)) return morphImageCache.get(url);
            const p = new Promise((resolve, reject) => {
                const pre = new Image();
                pre.decoding = 'sync';
                pre.loading = 'eager';
                pre.onload = async () => {
                    try { if (pre.decode) await pre.decode(); } catch (_) {}
                    resolve(pre);
                };
                pre.onerror = () => reject(new Error('Image failed: ' + url));
                pre.src = url;
            });
            morphImageCache.set(url, p);
            return p;
        }


        async function setMorphImage(methodKey, data, token) {
            const imgEl = document.getElementById(`morph-img-${methodKey}`);
            const fb = document.getElementById(`morph-fallback-${methodKey}`);
            if (!imgEl) return;
            const urls = [...new Set([data.img, data.encodedImg, data.unsplash].filter(Boolean))];
            for (const url of urls) {
                try {
                    const loaded = await preloadMorphImage(url);
                    if (morphRenderTokens[methodKey] !== token) return;
                    // Swap only after the replacement image is already decoded.
                    imgEl.onerror = null;
                    imgEl.src = loaded.currentSrc || loaded.src || url;
                    imgEl.setAttribute('decoding', 'sync');
                    imgEl.setAttribute('loading', 'eager');
                    imgEl.style.display = 'block';
                    imgEl.style.visibility = 'visible';
                    imgEl.style.opacity = '1';
                    imgEl.removeAttribute('hidden');
                    if (fb) fb.classList.add('hidden');
                    return;
                } catch (_) {}
            }
            // Do NOT hide the previous image if a replacement fails.
            // The existing image is preferable to a blank card.
        }


