  if(!mind || mind.dataset.converted) continue;
  mind.dataset.converted='1';
  const wrap=document.createElement('div');
  wrap.className='step-scroll-replace';
  const nodes=[...mind.querySelectorAll('.node-branch')];
  nodes.forEach((n,idx)=>{
    const card=document.createElement('div'); card.className='step-card-horizontal';
    const img=n.querySelector('img'); if(img) card.appendChild(img.cloneNode(true));
    const title=document.createElement('div'); title.className='step-number-horizontal'; title.textContent='Bước '+(idx+1); card.appendChild(title);
    const txt=document.createElement('div'); txt.innerHTML=n.innerText||''; card.appendChild(txt);
    wrap.appendChild(card);
  });
  if(nodes.length){ mind.style.display='none'; mind.parentNode.insertBefore(wrap,mind); }
 }
}
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',makeSteps); else makeSteps();
})();
</script>

