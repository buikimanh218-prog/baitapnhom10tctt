        function slideTo(methodKey, index) {
            const limit = slideLimits[methodKey];
            if (index < 0) index = limit - 1;
            if (index >= limit) index = 0;
            
            currentSlideIndex[methodKey] = index;
            const track = document.getElementById(`slider-track-${methodKey}`);
            if (track) {
                track.style.transform = `translateX(-${index * 100}%)`;
                
                // Active slide effect: Squash and Stretch Elastic bounce
                const activeSlide = track.children[index];
                if (activeSlide) {
                    activeSlide.classList.remove('animate-morph-bounce');
                    void activeSlide.offsetWidth; // force reflow
                    activeSlide.classList.add('animate-morph-bounce');
                }
            }
            
            // Trigger magical stardust explosion (silent transition as requested)
            createStardustExplosion(`slider-track-${methodKey}`);
            
            // Update tab buttons style
            const btns = document.querySelectorAll(`.tab-${methodKey}-btn`);
            btns.forEach((btn, idx) => {
