            imgEl.onerror = null; // Prevent loop
            // Attempt to load fallback local URL
            imgEl.src = fallbackLocal;
            imgEl.addEventListener('error', function onLocalErr() {
                imgEl.removeEventListener('error', onLocalErr);
                // Attempt to load Unsplash URL
